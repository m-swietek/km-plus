{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "km-plus",
  "version": "0.1.2",
  "identifier": "io.github.m-swietek.kmplus",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "km-plus",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxQzREREZERDMyRjY1MDYKUldRR1pTL1QvZDNFc2ZhK2lUckxkOU9qRHIvNi9XbFJCYjRzamtJUkpuditrWm14S3dJRzFPVS8K",
      "endpoints": [
        "https://github.com/m-swietek/km-plus/releases/latest/download/latest.json"
      ]
    }
  }
}